{
  "name": "gemini-live-pump-rearm",
  "provider": "gemini",
  "doc_url": "https://ai.google.dev/api/live",
  "doc_accessed": "2026-08-24",
  "channel_protocol_version": 1,
  "steps": [
    {
      "expect_handshake": {
        "connection": 1,
        "target_absent": ["key=", "access_token", "fixture-gemini-key"],
        "headers_present": ["x-goog-api-key"]
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"setup\"",
          "models/gemini-2.5-flash-native-audio-preview",
          "\"responseModalities\""
        ],
        "absent": ["fixture-gemini-key"]
      }
    },
    {
      "send_text": {
        "text": "{\"setupComplete\":{}}"
      }
    },
    {
      "send_text": {
        "text": "{\"toolCall\":{\"functionCalls\":[{\"id\":\"anchor-1\",\"name\":\"teacher_anchor\",\"args\":{\"kind\":\"figure\",\"id\":\"fig-2\"}}]}}"
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"toolResponse\"",
          "\"id\":\"anchor-1\"",
          "\"name\":\"teacher_anchor\"",
          "\"applied\":true"
        ],
        "absent": ["fixture-gemini-key", "\"error\""]
      }
    },
    {
      "send_text": {
        "text": "{\"serverContent\":{\"interrupted\":true}}"
      }
    },
    {
      "send_text": {
        "text": "{\"toolCall\":{\"functionCalls\":[{\"id\":\"anchor-2\",\"name\":\"teacher_anchor\",\"args\":{\"kind\":\"table\",\"id\":\"tbl-1\"}}]}}"
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"toolResponse\"",
          "\"id\":\"anchor-2\"",
          "\"name\":\"teacher_anchor\"",
          "\"applied\":true"
        ],
        "absent": ["fixture-gemini-key", "\"error\"", "stale_generation"]
      }
    },
    {
      "send_text": {
        "text": "{\"serverContent\":{\"turnComplete\":true}}"
      }
    },
    {
      "send_text": {
        "text": "{\"toolCall\":{\"functionCalls\":[{\"id\":\"anchor-3\",\"name\":\"teacher_anchor\",\"args\":{\"kind\":\"section\",\"id\":\"sec-9\"}}]}}"
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"toolResponse\"",
          "\"id\":\"anchor-3\"",
          "\"name\":\"teacher_anchor\"",
          "\"error\"",
          "stale_generation"
        ],
        "absent": ["fixture-gemini-key", "applied"]
      }
    }
  ]
}
