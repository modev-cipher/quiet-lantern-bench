{
  "name": "gemini-live-context-update",
  "provider": "gemini",
  "doc_url": "https://ai.google.dev/api/live",
  "doc_accessed": "2026-08-21",
  "channel_protocol_version": 1,
  "steps": [
    {
      "expect_handshake": {
        "connection": 1,
        "target_absent": ["key=", "access_token", "fixture-gemini-key"],
        "headers_present": ["x-goog-api-key"]
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"setup\"",
          "models/gemini-2.5-flash-native-audio-preview",
          "\"responseModalities\""
        ],
        "absent": ["fixture-gemini-key"]
      }
    },
    {
      "send_text": {
        "text": "{\"setupComplete\":{}}"
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"clientContent\"",
          "\"turnComplete\":false",
          "\"role\":\"user\"",
          "chapter nine begins"
        ],
        "absent": [
          "fixture-gemini-key",
          "\"setup\"",
          "\"realtimeInput\"",
          "\"turnComplete\":true"
        ]
      }
    }
  ]
}
