{
  "name": "elevenlabs-alignment-accumulation",
  "provider": "elevenlabs",
  "doc_url": "https://elevenlabs.io/docs/api-reference/text-to-speech/v-1-text-to-speech-voice-id-stream-input",
  "doc_accessed": "2026-08-22",
  "channel_protocol_version": 1,
  "steps": [
    {
      "expect_handshake": {
        "connection": 1,
        "target_contains": [
          "/v1/text-to-speech/",
          "/stream-input",
          "model_id=",
          "sync_alignment=true"
        ],
        "target_absent": [
          "xi-api-key",
          "authorization",
          "single_use_token",
          "fixture-elevenlabs-key"
        ],
        "headers_present": ["xi-api-key"]
      }
    },
    {
      "expect_text": {
        "contains": ["\"text\":\" \""],
        "absent": ["fixture-elevenlabs-key"]
      }
    },
    {
      "expect_text": {
        "contains": ["\"text\":\"Hi there again. \""],
        "absent": ["fixture-elevenlabs-key"]
      }
    },
    {
      "send_text": {
        "text": "{\"audio\":\"AgD9/w==\",\"alignment\":{\"chars\":[\"H\",\"i\",\" \",\"t\",\"h\",\"e\",\"r\",\"e\",\" \"],\"charStartTimesMs\":[0,120,240,300,420,540,660,780,900],\"charDurationsMs\":[120,120,60,120,120,120,120,120,100]}}"
      }
    },
    {
      "send_text": {
        "text": "{\"audio\":\"AgD9/w==\",\"alignment\":{\"chars\":[\"a\",\"g\",\"a\",\"i\",\"n\",\".\"],\"charStartTimesMs\":[0,100,200,300,400,500],\"charDurationsMs\":[100,100,100,100,100,80]}}"
      }
    },
    {
      "send_text": {
        "text": "{\"audio\":null,\"isFinal\":true}"
      }
    }
  ]
}
