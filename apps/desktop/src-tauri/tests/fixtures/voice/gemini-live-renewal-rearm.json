        "text": "{\"serverContent\":{\"modelTurn\":{\"parts\":[{\"inlineData\":{\"mimeType\":\"audio/pcm;rate=24000\",\"data\":\"VwSp+64IUvcFDQ==\"}}]}}}"
      }
    },
    {
      "send_text": {
