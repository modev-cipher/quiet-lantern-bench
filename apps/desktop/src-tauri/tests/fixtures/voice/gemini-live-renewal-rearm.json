        "text": "{\"serverContent\":{\"modelTurn\":{\"parts\":[{\"inlineData\":{\"mimeType\":\"audio/pcm;rate=24000\",\"data\":\"XBGk7rMVTeo=\"}}]}}}"
      }
    }
  ]
}
