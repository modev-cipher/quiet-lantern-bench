{
  "name": "gemini-live-tool-calls",
  "provider": "gemini",
  "doc_url": "https://ai.google.dev/api/live",
  "doc_accessed": "2026-08-21",
  "channel_protocol_version": 1,
  "steps": [
    {
      "expect_handshake": {
        "connection": 1,
        "target_absent": ["key=", "access_token", "fixture-gemini-key"],
        "headers_present": ["x-goog-api-key"]
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"setup\"",
          "models/gemini-2.5-flash-native-audio-preview",
          "\"responseModalities\""
        ],
        "absent": ["fixture-gemini-key"]
      }
    },
    {
      "send_text": {
        "text": "{\"setupComplete\":{}}"
      }
    },
    {
      "send_text": {
        "text": "{\"toolCall\":{\"functionCalls\":[{\"id\":\"call-7\",\"name\":\"seek_relative\",\"args\":{\"seconds\":-30}}]}}"
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"toolResponse\"",
          "\"functionResponses\"",
          "\"id\":\"call-7\"",
          "\"name\":\"seek_relative\"",
          "\"position_ms\":41000"
        ],
        "absent": ["fixture-gemini-key", "\"error\""]
      }
    },
    {
      "send_text": {
        "text": "{\"toolCall\":{\"functionCalls\":[{\"id\":\"anchor-2\",\"name\":\"teacher_anchor\",\"args\":{\"kind\":\"section\",\"id\":\"sec-9\"}}]}}"
      }
    },
    {
      "expect_text": {
        "contains": [
          "\"toolResponse\"",
          "\"id\":\"anchor-2\"",
          "\"name\":\"teacher_anchor\"",
          "\"error\"",
          "stale_generation"
        ],
        "absent": ["fixture-gemini-key", "applied"]
      }
    },
    {
      "send_text": {
        "text": "{\"toolCall\":{\"functionCalls\":[{\"id\":\"call-9\",\"name\":\"pause_playback\",\"args\":{}}]}}"
      }
    },
    {
      "send_text": {
        "text": "{\"toolCallCancellation\":{\"ids\":[\"call-9\"]}}"
      }
    },
    {
      "send_text": {
        "text": "{\"serverContent\":{\"outputTranscription\":{\"text\":\"after the cancellation\"}}}"
      }
    }
  ]
}
