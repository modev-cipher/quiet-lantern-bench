{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "txtCaster",
  "version": "1.0.0",
  "identifier": "io.github.meedoomostafa.txtcaster",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "txtCaster",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/txtcaster/**",
          "$CACHE/txtcaster/**",
          "$DATA/io.github.meedoomostafa.txtcaster/**",
          "$CACHE/io.github.meedoomostafa.txtcaster/**",
          "$APPDATA/**",
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
