{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "txtCaster",
  "version": "1.0.0",
  "identifier": "io.github.meedoomostafa.txtcaster",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "txtCaster",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:*",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/txtcaster/**",
          "$CACHE/txtcaster/**",
          "$DATA/io.github.meedoomostafa.txtcaster/**",
          "$CACHE/io.github.meedoomostafa.txtcaster/**",
          "$LOCALDATA/txtcaster-data/**",
          "$LOCALDATA/txtcaster-cache/**",
          "$APPDATA/**",
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
